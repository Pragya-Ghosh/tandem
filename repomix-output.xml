              aria-selected={activeTab === tab.id}
              onClick={() => onSelectTab(tab.id)}
            >
              {tab.label}
            </button>
          </span>
        ))}
      </nav>
      <span className="fg hidden italic sm:block">{DOCUMENT_PATH}</span>
    </Box>
  );
}
